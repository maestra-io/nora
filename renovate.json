{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "github>maestra-io/renovate-config:externalImages"],
  "minimumReleaseAge": "5 days",
  "cargo": { "enabled": true },
  "github-actions": { "enabled": true },
  "schedule": ["before 9am on Monday"],
  "prConcurrentLimit": 3,
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Auto-merge patch updates that pass CI and are 5 days old. Digest moves are new content and wait for a human (issues-maestra#1649)",
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "5 days",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    }
  ]
}
